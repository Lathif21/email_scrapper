# Copy this file to .env and fill in real values:
#     cp .env.example .env          (macOS/Linux)
#     copy .env.example .env        (Windows CMD)
#     Copy-Item .env.example .env   (PowerShell)
#
# .env is gitignored — never commit it. This example file is safe to commit
# because it contains no real values.

# Required for 'main.py --encrypt' and for decrypt.py.
# Use the SAME password to decrypt that you used to encrypt — there is no
# recovery path if you lose it.
SCRAPER_PASSWORD=

# Only needed if you switch from Bing scraping to the Google Custom Search
# JSON API (see GOOGLE_API_SETUP.md). Leave blank otherwise.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
