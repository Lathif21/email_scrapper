# Copy this file to .env and fill in real values:
#     cp .env.example .env          (macOS/Linux)
#     copy .env.example .env        (Windows CMD)
#     Copy-Item .env.example .env   (PowerShell)
#
# .env is gitignored — never commit it. This example file is safe to commit
# because it contains no real values.

# Required for 'main.py --encrypt' and for decrypt.py.
# Use the SAME password to decrypt that you used to encrypt — there is no
# recovery path if you lose it.
SCRAPER_PASSWORD=

# Required for the default search backend (--engine serper).
# Get a key at https://serper.dev — see SEARCH_BACKEND.md for the credit model.
# Without this, stage 1 stops with a setup message; it never silently falls
# back to Bing, because Bing returns results for other people's queries.
SERPER_API_KEY=
